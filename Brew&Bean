  .menu-toggle { display: block; order: 3; }
  .header-cta { display: none; }
  .site-nav { display: none; position: absolute; top: 69px; left: 0; right: 0; padding: 18px 24px 22px; background: var(--paper); border-bottom: 1px solid var(--line); box-shadow: 0 12px 20px rgba(30,25,15,.07); }
  .site-nav.open { display: grid; gap: 0; }
  .site-nav a { padding: 12px 0; border-bottom: 1px solid var(--line); }
  .site-nav a:last-child { border-bottom: 0; }
  .hero { min-height: 560px; background-position: 58% center; }
  .hero-shade { background: linear-gradient(90deg, rgba(18,16,13,.88), rgba(18,16,13,.45)); }
  .section-pad { padding-block: 76px; }
  .menu-grid { grid-template-columns: repeat(2, 1fr); }
  .menu-image { height: 200px; }
  .about-grid, .contact-grid { grid-template-columns: 1fr; gap: 50px; }
  .about-photo { min-height: 400px; margin-right: 18px; }
  .about-copy { max-width: 620px; }
  .contact-grid { gap: 42px; }
  .contact-visual { max-width: 650px; width: 100%; }
}
@media (max-width: 560px) {
  .container { width: min(100% - 36px, 440px); }
  .logo { font-size: 16px; }
  .logo-mark { width: 29px; height: 29px; font-size: 18px; }
  .hero { min-height: 590px; background-position: 62% center; }
  .hero-content { padding-block: 84px 100px; }
  h1 { font-size: clamp(42px, 12vw, 59px); }
  .hero-copy { max-width: 360px; font-size: 13px; }
  .hero-actions { align-items: flex-start; flex-direction: column; gap: 15px; }
  .hero-caption { left: 18px; bottom: 22px; }
  .section-pad { padding-block: 64px; }
  .section-heading { display: block; margin-bottom: 28px; }
  .section-intro { margin-top: 17px; }
  .menu-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
  .menu-image { height: 145px; }
  .menu-card-body { padding: 13px 12px; }
  .menu-title { display: block; }
  .menu-title h3 { font-size: 13px; }
  .menu-title span { display: inline-block; margin-top: 5px; }
  .menu-card-body p { min-height: 48px; margin: 8px 0 12px; font-size: 11px; }
  .menu-tag { font-size: 8px; }
  .about-photo { min-height: 320px; }
  .about-copy > p:not(.eyebrow) { font-size: 13px; }
  .contact-list { grid-template-columns: 1fr; gap: 19px; margin: 28px 0; }
  .map-card { min-height: 270px; border-width: 5px; }
  .footer-inner { grid-template-columns: 1fr auto; gap: 12px; }
  .footer-inner > p { grid-column: 1 / -1; grid-row: 2; }
  .back-top { grid-column: 2; grid-row: 1; }
  .footer-inner > small { grid-row: 3; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }
}

  </footer>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</body>
</html>
